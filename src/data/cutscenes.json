       "scale": 2,
       "flip": false,
       "enter": "fade"
      },
      {
       "anim": "enemy_thrall_idle",
       "x": 0.7,
       "y": 0.96,
       "scale": 2,
       "flip": true,
       "enter": "fade"
      }
     ],
     "lines": [
      {
       "speaker": "Abel",
       "text": "...Lord, let these be only rumours."
      }
     ]
    }
   ]
  },
