     ],
     "lines": [
      {
       "speaker": "Sister Paula",
       "text": "Halt. By order of the Holy Inquisition, you will kneel.",
       "voice": "paula_intro_0_0"
      },
      {
       "speaker": "Abel",
       "text": "Ah — good evening, Sister. Only a priest from Rome, I'm afraid. Terribly lost."
      }
     ]
    },
    {
     "layout": "right",
     "bg": "rooms/water_tunnels_w0",
     "tint": "0xa06070",
     "actors": [
      {
       "anim": "boss_paula_dash",
       "x": 0.5,
       "y": 0.96,
       "scale": 2,
       "flip": true,
       "enter": "right"
      }
     ],
     "fx": "speedlines",
     "lines": [
      {
       "speaker": "Sister Paula",
       "text": "A priest who walks the dark under Istvan without a lamp. People vanish here, Father. Their blood is found. They are not."
      },
      {
       "speaker": "Sister Paula",
       "text": "The Inquisition hunts whatever does it. Kneel, or be judged with it."
      }
     ]
    },
    {
     "layout": "left",
     "bg": "rooms/water_tunnels_w0",
     "actors": [
      {
       "anim": "abel_idle",
       "x": 0.5,
       "y": 0.96,
       "scale": 3,
       "flip": false,
       "enter": "fade"
      }
     ],
     "lines": [
      {
       "speaker": "Abel",
       "text": "Then I suppose we'll settle this the hard way. Forgive me, Sister."
      }
     ]
    }
   ]
  },
