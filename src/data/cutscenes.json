 "scenes": {
  "opening": {
   "panels": [
    {
     "layout": "full",
     "bg": "cathedral_front",
     "tint": "0x8a7ca0",
     "caption": "Istvan. A city freed from its Methuselah lord only a season ago.",
     "actors": [
      {
       "anim": "abel_walk",
       "x": 0.3,
       "y": 0.96,
       "scale": 2,
       "flip": false,
       "enter": "left"
      }
     ],
     "lines": [
      {
       "speaker": "Abel",
       "text": "Istvan... prettier than the reports said. Colder, too.",
       "voice": "opening_0_0"
      },
      {
       "speaker": "Sealed orders",
       "text": "Its people vanish by night into the old water tunnels. Go below. Learn who takes them, and why. Trust no one. — C.",
       "voice": "opening_0_1"
      }
     ]
    },
    {
     "layout": "left",
     "bg": "rooms/sewer_shaft_w0",
     "tint": "0x6a6a8a",
     "actors": [
      {
       "anim": "abel_idle",
       "x": 0.5,
       "y": 0.96,
       "scale": 2,
       "flip": false,
       "enter": "fade"
      }
     ],
     "lines": [
      {
       "speaker": "Abel",
       "text": "Down into the dark, then. On an empty stomach. Splendid.",
       "voice": "opening_1_0"
      }
     ]
    },
    {
     "layout": "right",
     "bg": "rooms/hunters_crypt_w0",
     "tint": "0x7a5060",
     "actors": [
      {
       "anim": "enemy_thrall_walk",
       "x": 0.35,
       "y": 0.96,
       "scale": 2,
       "flip": false,
       "enter": "fade"
      },
      {
       "anim": "enemy_thrall_idle",
       "x": 0.7,
       "y": 0.96,
       "scale": 2,
       "flip": true,
       "enter": "fade"
      }
     ],
     "lines": [
      {
       "speaker": "Abel",
       "text": "...Lord, let these be only rumours."
      }
     ]
    }
   ]
  },
  "paula_intro": {
   "panels": [
    {
     "layout": "full",
     "bg": "rooms/water_tunnels_w0",
     "caption": "The Water Tunnels.",
