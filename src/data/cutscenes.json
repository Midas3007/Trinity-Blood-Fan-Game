       "anim": "abel_idle",
       "x": 0.5,
       "y": 0.96,
       "scale": 2,
       "flip": false,
       "enter": "fade"
      }
     ],
     "lines": [
      {
       "speaker": "Abel",
       "text": "Down into the dark, then. On an empty stomach. Splendid."
      }
     ]
    },
    {
     "layout": "right",
     "bg": "rooms/hunters_crypt_w0",
     "tint": "0x7a5060",
